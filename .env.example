# ================= OpenAI 兼容接口（LLM + Embedding） =================
# 以下配置同时支持 OpenAI 官方、智谱 GLM、Kimi、DeepSeek 等兼容 OpenAPI 协议的服务
# 只需修改 BASE_URL 与对应 MODEL_ID 即可

# API 密钥
OPENAI_API_KEY=sk-your-key-here
# 接口地址（示例：智谱 https://open.bigmodel.cn/api/paas/v4 / OpenAI https://api.openai.com/v1）
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 对话模型 ID
OPENAI_MODEL_ID=glm-4-flash
# 向量化模型 ID
EMBEDDING_MODEL_ID=embedding-3

# ================= 智谱 Rerank（仅 Rerank 用，可留空走降级） =================
ZHIPUAI_API_KEY=your-zhipuai-key-here

# ================= 应用层配置（可选，留空走默认值） =================
# 日志级别 DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# LLM/Embedding 单次请求超时秒数（长回答生成慢时可调大，默认 60）
REQUEST_TIMEOUT=60
# FastAPI 服务端口
API_PORT=8000
# Gradio 服务端口
GRADIO_PORT=7860
